# ~/.config/kilo/env: environment for kilo.service (systemd EnvironmentFile
# syntax: KEY=value, no `export`, no shell expansion). Created by install.sh
# if missing; never overwritten.

# The body's serial port. The CH343 USB adapter in one of the Pi's USB ports
# for now; the Pi 2 B's header UART (PL011) once the Pi sits on the NyBoard.
KILO_PORT=/dev/ttyACM0
#KILO_PORT=/dev/ttyAMA0

# A missing port is fine: the daemon waits for it (and for a USB replug).
# /dev/serial/by-id/usb-... pins the adapter even if it comes back as ttyACM1.

# Extra `kilo run` arguments: --behaviour (the behaviour runner), --remote (act on the
# IR remote's keys; map in mind/README.md; since P2 the direction keys make Kilo
# WALK: only with Kilo on the floor, never on a desk), --balance [KP] (balance on
# by default whenever Kilo stands, sits or walks; Kp 0.5 unless given, 0.99 levels
# the whole slope), --log (the JSON-lines
# frame log, off by default: ~64 MB x 6 per daemon start), --kilolog
# (raw frames to ~/kilo-logs/kilo-<time>.kilolog.gz), --log-dir DIR.
# The daemon's own log is always ~/kilo-logs/daemon.log (or <log-dir>/daemon.log).
#KILO_RUN_ARGS=--behaviour --kilolog
#KILO_RUN_ARGS=--behaviour --log
#KILO_RUN_ARGS=--remote --kilolog
#KILO_RUN_ARGS=--remote --balance 0.99   # Kilo wakes up with the remote live and balance on
# ~/kilo-logs is pruned to 500 MB at daemon start and hourly (oldest kilo logs first).
KILO_RUN_ARGS=

# Personality file for the behaviour runner (default: the packaged one).
#KILO_PERSONALITY=/home/joe/kilo-personality.yaml

# Socket override (default: $XDG_RUNTIME_DIR/kilo/kilo.sock = /run/user/<uid>/kilo/kilo.sock,
# which the CLI also finds from an SSH shell without $XDG_RUNTIME_DIR).
#KILO_SOCKET=
