# ~/.config/kilo/env: environment for kilo.service (systemd EnvironmentFile
# syntax: KEY=value, no `export`, no shell expansion). Created by install.sh
# if missing; never overwritten.

# The body's serial port. The CH343 USB adapter in one of the Pi's USB ports
# for now; the Pi 2 B's header UART (PL011) once the Pi sits on the NyBoard.
KILO_PORT=/dev/ttyACM0
#KILO_PORT=/dev/ttyAMA0

# Extra `kilo run` arguments, e.g. the behaviour runner or a log directory.
#KILO_RUN_ARGS=--behaviour --log-dir /home/joe/kilo-logs
KILO_RUN_ARGS=

# Socket override (default: $XDG_RUNTIME_DIR/kilo/kilo.sock = /run/user/<uid>/kilo/kilo.sock).
#KILO_SOCKET=
